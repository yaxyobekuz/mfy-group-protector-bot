# ── TELEGRAM ──────────────────────────────────────────────────────────
BOT_TOKEN=""

# ── SERVER ────────────────────────────────────────────────────────────
# ⚠️ BOTDA BAZA ULANISHI YO'Q va bo'lmaydi: u faqat server API'si
# orqali ishlaydi. Sabab — `README.md` dagi "Botda Prisma yo'q" bo'limi.
API_URL="http://localhost:4000/api"

# Server bilan AYNI qiymat (`BOT_API_KEY`). Har so'rovda `X-Bot-Key`
# sarlavhasida yuboriladi.
BOT_API_KEY="almashtiring-bot-kalitini"

# ── QO'SHIMCHA ────────────────────────────────────────────────────────
NODE_ENV=development
# Server javobini qancha kutadi (ms).
API_TIMEOUT_MS=15000
